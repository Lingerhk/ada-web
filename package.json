  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint --max-warnings=0 vite.config.ts vitest.config.ts playwright.config.ts src/utils/build.ts src/utils/chunks.ts src/utils/chunks.test.ts tests/e2e/login.spec.ts",
    "lint:fix": "npm run lint -- --fix",
    "lint-fix": "npm run lint:fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.check.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "download-proto": "cp /home/adadmin/adaegis/ada/backend/apiserver/api/v2/ada.proto proto/ada.proto",
    "format-proto": "bash ./proto/format-proto.sh",
    "build-proto": "grpc_tools_node_protoc --ts_out=./src/api/grpc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts -I ./proto ./proto/*.proto",
    "upload-dist": "rsync -avz -e 'ssh -c aes128-ctr' --progress dist/ 192.168.6.4:~/ada_web"
  },
